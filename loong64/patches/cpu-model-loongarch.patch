+      }
+      std::string value = StringUtils::trim(std::string_view(line).substr(colonPos + 1));
+      // x86 "processor : 0" is an index, not a model name.
+      if (value.empty() || isPureNumber(value)) {
+        continue;
+      }
+      best = std::move(value);
+      bestRank = rank;
+      if (bestRank == 0) {
