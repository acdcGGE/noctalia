 namespace {
 
+  // /proc/cpuinfo keys are architecture-specific:
+  //   x86:            "model name : Intel(R) Core(TM) ..."
+  //   LoongArch:      "Model Name : Loongson-3A5000"   (capital M/N)
+  //   MIPS/Loongson:  "cpu model  : Loongson-3A5000 ..."
+  //   ARM:            "Hardware   : BCM2711" / "Processor : ARMv8 ..."
+  // Normalize the key (lowercase, drop separators) so one lookup works on all
+  // of them, and prefer the most specific field available.
+  int cpuInfoKeyRank(std::string_view key) {
+    std::string normalized;
+    normalized.reserve(key.size());
+    for (const char ch : key) {
+      const auto uc = static_cast<unsigned char>(ch);
+      if (std::isalnum(uc) != 0) {
+        normalized.push_back(static_cast<char>(std::tolower(uc)));
+      }
+    }
+    if (normalized == "modelname") return 0;
+    if (normalized == "cpumodel") return 1;
+    if (normalized == "hardware") return 2;
+    if (normalized == "processor") return 3;
+    return -1;
+  }
+
+  bool isPureNumber(std::string_view value) {
+    return std::ranges::all_of(value, [](const char ch) {
+      const auto uc = static_cast<unsigned char>(ch);
+      return std::isdigit(uc) != 0 || std::isspace(uc) != 0;
+    });
+  }
+
   std::string readCpuModel() {
